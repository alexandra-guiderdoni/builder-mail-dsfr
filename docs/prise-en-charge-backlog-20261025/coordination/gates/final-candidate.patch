+      let run = 0, longest = 0;
+      for (let i = 0; i < pixels.length; i += 4) {
+        run = pixels[i] === 106 && pixels[i + 1] === 106 && pixels[i + 2] === 244 && pixels[i + 3] === 255 ? run + 1 : 0;
